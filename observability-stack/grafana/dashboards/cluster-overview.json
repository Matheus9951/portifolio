{
  "title": "Cluster Overview",
  "uid": "cluster-overview",
  "tags": ["kubernetes", "cluster"],
  "timezone": "browser",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "title": "CPU Usage por Node",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(node_cpu_seconds_total{mode!='idle'}[5m])) by (node) / sum(rate(node_cpu_seconds_total[5m])) by (node) * 100",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Memória Usada por Node",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / node_memory_MemTotal_bytes * 100",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Pods por Namespace",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "count(kube_pod_info) by (namespace)",
          "legendFormat": "{{namespace}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Pods em estado não-Running",
      "type": "table",
      "gridPos": { "h": 4, "w": 18, "x": 6, "y": 8 },
      "targets": [
        {
          "expr": "kube_pod_status_phase{phase!='Running',phase!='Succeeded'} == 1",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ]
    }
  ]
}
